+static int rv1106_snapshot_start(Rv1106Ctx *c)
+{
+	const VencConfigSnapshot *snap = &c->cfg.snapshot;
+	uint32_t pw = 640, ph = (pw * c->height / c->width + 1u) & ~1u;
+	VencJpegConfig jcfg = {
+		.width = pw,
+		.height = ph ? ph : 480,
+		.quality = snap->quality,
+		.channel = snap->channel,
+		.enabled = snap->enabled,
+	};
+
+	/* Best effort: a failed preview must not take the video link down. */
+	(void)venc_jpeg_init(&jcfg);
+	return 0;
+}
+
+static int rv1106_init(void *opaque)
+{
+	Rv1106Ctx *c = opaque;
+	MPP_CHN_S src = { .enModId = RK_ID_VI, .s32DevId = RV1106_VI_DEV,
+		.s32ChnId = RV1106_VI_CHN };
+	MPP_CHN_S dst = { .enModId = RK_ID_VENC, .s32DevId = 0,
+		.s32ChnId = RV1106_VENC_CHN };
+
+	if (rv1106_isp_start(c) != 0)
+		return -1;
+	if (RK_MPI_SYS_Init() != RK_SUCCESS) {
+		fprintf(stderr, "ERROR: RK_MPI_SYS_Init failed\n");
+		return -1;
+	}
+	c->sys_up = true;
+	if (rv1106_vi_start(c) != 0 || rv1106_venc_start(c) != 0)
+		return -1;
+	if (RK_MPI_SYS_Bind(&src, &dst) != RK_SUCCESS) {
+		fprintf(stderr, "ERROR: SYS_Bind VI->VENC failed\n");
+		return -1;
+	}
+	c->bound = true;
+	rv1106_rtp_seed(c);
+	if (c->cfg.outgoing.server[0] &&
+	    rv1106_output_configure(c, c->cfg.outgoing.server) != 0 &&
+	    c->output_enabled)
+		return -1;
+
+	g_rv = c;
+	if (venc_api_register(&c->cfg, "rv1106", &g_rv1106_callbacks, NULL) != 0)
+		return -1;
+	(void)rv1106_snapshot_start(c);
+	if (venc_httpd_start(c->cfg.system.web_port) != 0)
+		return -1;
+	c->httpd_up = true;
+
+	printf("> RV1106: %ux%u@%u H.265 %s %ukbps -> %s\n", c->width,
+		c->height, c->fps, c->cfg.video0.rc_mode,
+		c->cfg.video0.bitrate, c->cfg.outgoing.server);
+	printf("> Web UI: http://<board-ip>:%u/\n", c->cfg.system.web_port);
+	return 0;
+}
+
+static int rtp_write(const uint8_t *header, size_t header_len,
+	const uint8_t *p1, size_t p1_len, const uint8_t *p2, size_t p2_len,
+	void *opaque)
+{
+	Rv1106Ctx *c = opaque;
+
+	return output_socket_send_parts(c->sock, &c->dst, c->dst_len,
+		c->connected_udp, header, header_len, p1, p1_len, p2, p2_len);
+}
+
+/* One VENC pack holds a whole Annex-B access unit (VPS/SPS/PPS inline on
+ * IDR).  Walk its NALs; the last one carries the RTP marker bit. */
+static void rv1106_send_au(Rv1106Ctx *c, const uint8_t *au, size_t len,
+	uint64_t pts_us)
+{
+	const uint8_t *nal, *next_nal;
+	size_t cur = 0, next_len, nal_len;
+	size_t max_payload = c->cfg.outgoing.max_payload_size;
+
+	if (!__atomic_load_n(&c->output_enabled, __ATOMIC_ACQUIRE))
+		return;
+	pthread_mutex_lock(&c->out_lock);
+	if (c->sock < 0) {
+		pthread_mutex_unlock(&c->out_lock);
+		return;
+	}
+
+	if (!max_payload)
+		max_payload = RTP_DEFAULT_PAYLOAD;
+	if (!h26x_util_annexb_next(au, len, &cur, &nal, &nal_len)) {
+		pthread_mutex_unlock(&c->out_lock);
+		return;
+	}
+	for (;;) {
+		int more = h26x_util_annexb_next(au, len, &cur, &next_nal,
+			&next_len);
+
+		hevc_rtp_send_nal(nal, nal_len, &c->rtp, rtp_write, c,
+			!more, max_payload, &c->rtp_stats);
+		if (!more)
+			break;
+		nal = next_nal;
+		nal_len = next_len;
+	}
+	/* Advance the 90 kHz RTP clock by the real time between frames (camera
+	 * PTS, microseconds) so playback speed follows the sensor, not the
+	 * configured fps.  Fall back to the nominal tick on a bad timestamp. */
+	{
+		uint64_t d = (c->last_pts_us && pts_us > c->last_pts_us) ?
+			pts_us - c->last_pts_us : 0;
+
+		if (d > 0 && d < 1000000ULL)
+			c->rtp.timestamp += (uint32_t)(d * 9 / 100);
+		else
+			c->rtp.timestamp += c->frame_ticks;
+		c->last_pts_us = pts_us;
+	}
+	pthread_mutex_unlock(&c->out_lock);
+}
+
+static int rv1106_run(void *opaque)
+{
+	Rv1106Ctx *c = opaque;
+	struct sigaction sa;
+	VENC_STREAM_S stream;
+	VENC_PACK_S pack;
+	time_t last_log = time(NULL);
+	uint32_t frames = 0, bytes = 0;
+
+	rv1106_install_crash_handler();
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = on_signal;
+	sigaction(SIGINT, &sa, NULL);
+	sigaction(SIGTERM, &sa, NULL);
+
+	while (!g_stop) {
+		RK_S32 ret;
+
+		if (venc_api_get_reinit()) {
+			venc_api_clear_reinit();
+			venc_respawn_request();
+			printf("> RV1106 reinit requested: cold restart via "
+				"fork+exec\n");
+			break;
+		}
+		memset(&stream, 0, sizeof(stream));
+		memset(&pack, 0, sizeof(pack));
+		stream.pstPack = &pack;
+		ret = RK_MPI_VENC_GetStream(RV1106_VENC_CHN, &stream,
+			RV1106_GET_STREAM_TIMEOUT_MS);
+		if (ret != RK_SUCCESS)
+			continue;
+
+		const uint8_t *base = RK_MPI_MB_Handle2VirAddr(pack.pMbBlk);
+		static int first = 1;
+
+		if (first) {
+			printf("rv1106: first AU len=%u off=%u base=%p\n",
+				pack.u32Len, pack.u32Offset, (const void *)base);
+			fflush(stdout);
+		}
+		if (base && pack.u32Len)
+			rv1106_send_au(c, base, pack.u32Len, pack.u64PTS);
+		if (first) {
+			printf("rv1106: first AU sent\n");
+			fflush(stdout);
+			first = 0;
+		}
+		frames++;
+		bytes += pack.u32Len;
+		RK_MPI_VENC_ReleaseStream(RV1106_VENC_CHN, &stream);
+
+		if (time(NULL) != last_log) {
+			__atomic_store_n(&c->live_fps, frames, __ATOMIC_RELEASE);
+			if (__atomic_load_n(&c->verbose, __ATOMIC_ACQUIRE))
+				printf("rv1106: %u fps, %u kbit/s\n", frames,
+					bytes * 8 / 1000);
+			frames = bytes = 0;
+			last_log = time(NULL);
+		}
+	}
+	return 0;
+}
+
+static void rv1106_teardown(void *opaque)
+{
+	Rv1106Ctx *c = opaque;
+	MPP_CHN_S src = { .enModId = RK_ID_VI, .s32DevId = RV1106_VI_DEV,
+		.s32ChnId = RV1106_VI_CHN };
+	MPP_CHN_S dst = { .enModId = RK_ID_VENC, .s32DevId = 0,
+		.s32ChnId = RV1106_VENC_CHN };
+
+	if (c->httpd_up) {
+		venc_httpd_pause();
+		venc_httpd_stop();
+	}
+	venc_jpeg_shutdown();
+	if (c->bound)
+		RK_MPI_SYS_UnBind(&src, &dst);
+	if (c->venc_up) {
+		RK_MPI_VENC_StopRecvFrame(RV1106_VENC_CHN);
+		RK_MPI_VENC_DestroyChn(RV1106_VENC_CHN);
+	}
+	if (c->vi_up) {
+		RK_MPI_VI_DisableChn(RV1106_VI_PIPE, RV1106_VI_CHN);
+		RK_MPI_VI_DisableDev(RV1106_VI_DEV);
+	}
+	if (c->aiq) {
+		rk_aiq_uapi2_sysctl_stop(c->aiq, false);
+		rk_aiq_uapi2_sysctl_deinit(c->aiq);
+	}
+	if (c->sys_up)
+		RK_MPI_SYS_Exit();
+	if (c->sock >= 0)
+		close(c->sock);
+}
+
+static int rv1106_map_result(int result)
+{
+	return result == 0 ? 0 : 1;
+}
+
+static const BackendOps g_rv1106_ops = {
+	.name = "rv1106",
+	.context_size = sizeof(Rv1106Ctx),
+	.config = rv1106_config,
+	.prepare = rv1106_prepare,
+	.init = rv1106_init,
+	.run = rv1106_run,
+	.teardown = rv1106_teardown,
+	.map_pipeline_result = rv1106_map_result,
+};
+
+const BackendOps *rv1106_runtime_backend_ops(void)
+{
+	return &g_rv1106_ops;
+}
