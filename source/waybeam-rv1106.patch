+/* Debug aid for first bring-up: report where a crash happened (PC/LR plus the
+ * module map) so it can be symbolised against the matching build. */
+static void on_fatal(int sig, siginfo_t *si, void *uc_v)
+{
+	const ucontext_t *uc = uc_v;
+	char buf[256];
+	int n, fd;
+	ssize_t r;
+
+	n = snprintf(buf, sizeof(buf),
+		"\nFATAL: signal %d tid %ld fault_addr %p pc %08lx lr %08lx sp %08lx\n",
+		sig, (long)syscall(SYS_gettid), si ? si->si_addr : NULL,
+		(unsigned long)uc->uc_mcontext.arm_pc,
+		(unsigned long)uc->uc_mcontext.arm_lr,
+		(unsigned long)uc->uc_mcontext.arm_sp);
+	if (n > 0)
+		(void)!write(2, buf, (size_t)n);
+	fd = open("/proc/self/maps", O_RDONLY);
+	if (fd >= 0) {
+		while ((r = read(fd, buf, sizeof(buf))) > 0)
+			(void)!write(2, buf, (size_t)r);
+		close(fd);
+	}
+	_exit(139);
+}
+
+static void rv1106_install_crash_handler(void)
+{
+	struct sigaction sa;
+
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_sigaction = on_fatal;
+	sa.sa_flags = SA_SIGINFO;
+	sigaction(SIGSEGV, &sa, NULL);
+	sigaction(SIGBUS, &sa, NULL);
+	sigaction(SIGABRT, &sa, NULL);
+}
+
+static void on_signal(int sig)
+{
+	(void)sig;
+	g_stop = 1;
+}
