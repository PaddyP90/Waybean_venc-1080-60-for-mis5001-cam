+static int rv1106_isp_start(Rv1106Ctx *c)
+{
+	const char *iq_dir = getenv("WAYBEAM_IQ_DIR");
+	rk_aiq_static_info_t info;
+	char hdr[8];
+
+	if (!iq_dir || !*iq_dir)
+		iq_dir = RV1106_IQ_DIR_DEFAULT;
+
+	rv1106_sensor_select_mode(c->width, c->height);
+
+	snprintf(hdr, sizeof(hdr), "%d", (int)RK_AIQ_WORKING_MODE_NORMAL);
+	setenv("HDR_MODE", hdr, 1);
+
+	memset(&info, 0, sizeof(info));
+	if (rk_aiq_uapi2_sysctl_enumStaticMetasByPhyId(RV1106_CAM_ID, &info)) {
+		fprintf(stderr, "ERROR: no sensor found on CSI port %d "
+			"(is the mis5001 driver loaded? check dmesg)\n",
+			RV1106_CAM_ID);
+		return -1;
+	}
+	printf("> ISP: sensor %s, iqfiles %s\n", info.sensor_info.sensor_name,
+		iq_dir);
+
+	rk_aiq_uapi2_sysctl_preInit_devBufCnt(info.sensor_info.sensor_name,
+		"rkraw_rx", 2);
+	c->aiq = rk_aiq_uapi2_sysctl_init(info.sensor_info.sensor_name,
+		iq_dir, NULL, NULL);
+	if (!c->aiq) {
+		fprintf(stderr, "ERROR: rk_aiq init failed (IQ file missing "
+			"for %s in %s?)\n", info.sensor_info.sensor_name,
+			iq_dir);
+		return -1;
+	}
+	if (rk_aiq_uapi2_sysctl_prepare(c->aiq, 0, 0,
+		RK_AIQ_WORKING_MODE_NORMAL) ||
+	    rk_aiq_uapi2_sysctl_start(c->aiq)) {
+		fprintf(stderr, "ERROR: rk_aiq prepare/start failed\n");
+		rk_aiq_uapi2_sysctl_deinit(c->aiq);
+		c->aiq = NULL;
+		return -1;
+	}
+	return 0;
+}
+
+static int rv1106_vi_start(Rv1106Ctx *c)
+{
+	VI_DEV_ATTR_S dev_attr;
+	VI_DEV_BIND_PIPE_S bind_pipe;
+	VI_CHN_ATTR_S chn;
+	RK_S32 ret;
+
+	memset(&dev_attr, 0, sizeof(dev_attr));
+	memset(&bind_pipe, 0, sizeof(bind_pipe));
+	memset(&chn, 0, sizeof(chn));
+
+	ret = RK_MPI_VI_GetDevAttr(RV1106_VI_DEV, &dev_attr);
+	if (ret == RK_ERR_VI_NOT_CONFIG) {
+		ret = RK_MPI_VI_SetDevAttr(RV1106_VI_DEV, &dev_attr);
+		if (ret != RK_SUCCESS) {
+			fprintf(stderr, "ERROR: VI_SetDevAttr %#x\n", ret);
+			return -1;
+		}
+	}
+	if (RK_MPI_VI_GetDevIsEnable(RV1106_VI_DEV) != RK_SUCCESS) {
+		ret = RK_MPI_VI_EnableDev(RV1106_VI_DEV);
+		if (ret != RK_SUCCESS) {
+			fprintf(stderr, "ERROR: VI_EnableDev %#x\n", ret);
+			return -1;
+		}
+		bind_pipe.u32Num = 1;
+		bind_pipe.PipeId[0] = RV1106_VI_PIPE;
+		ret = RK_MPI_VI_SetDevBindPipe(RV1106_VI_DEV, &bind_pipe);
+		if (ret != RK_SUCCESS) {
+			fprintf(stderr, "ERROR: VI_SetDevBindPipe %#x\n", ret);
+			return -1;
+		}
+	}
+
+	chn.stIspOpt.u32BufCount = 2;
+	chn.stIspOpt.enMemoryType = VI_V4L2_MEMORY_TYPE_DMABUF;
+	chn.stSize.u32Width = c->width;
+	chn.stSize.u32Height = c->height;
+	chn.enPixelFormat = RK_FMT_YUV420SP;
+	chn.enCompressMode = COMPRESS_MODE_NONE;
+	chn.u32Depth = 0;
+	chn.bMirror = c->cfg.image.mirror ? RK_TRUE : RK_FALSE;
+	chn.bFlip = c->cfg.image.flip ? RK_TRUE : RK_FALSE;
+	ret = RK_MPI_VI_SetChnAttr(RV1106_VI_PIPE, RV1106_VI_CHN, &chn);
+	if (ret != RK_SUCCESS) {
+		fprintf(stderr, "ERROR: VI_SetChnAttr %#x\n", ret);
+		return -1;
+	}
+	ret = RK_MPI_VI_EnableChn(RV1106_VI_PIPE, RV1106_VI_CHN);
+	if (ret != RK_SUCCESS) {
+		fprintf(stderr, "ERROR: VI_EnableChn %#x\n", ret);
+		return -1;
+	}
+	c->vi_up = true;
+	return 0;
+}
+
+static void rv1106_fill_rc(Rv1106Ctx *c, VENC_RC_ATTR_S *rc)
+{
+	const VencConfigVideo *v = &c->cfg.video0;
+	uint32_t gop = (uint32_t)(v->gop_size * c->fps + 0.5);
+
+	if (gop == 0)
+		gop = 1; /* all-intra */
+
+	if (!strcmp(v->rc_mode, "vbr")) {
+		rc->enRcMode = VENC_RC_MODE_H265VBR;
+		rc->stH265Vbr.u32Gop = gop;
+		rc->stH265Vbr.u32SrcFrameRateNum = c->fps;
+		rc->stH265Vbr.u32SrcFrameRateDen = 1;
+		rc->stH265Vbr.fr32DstFrameRateNum = c->fps;
+		rc->stH265Vbr.fr32DstFrameRateDen = 1;
+		rc->stH265Vbr.u32BitRate = v->bitrate;
+		rc->stH265Vbr.u32MaxBitRate = v->bitrate * 3 / 2;
+		rc->stH265Vbr.u32MinBitRate = v->bitrate / 4;
+	} else if (!strcmp(v->rc_mode, "avbr")) {
+		rc->enRcMode = VENC_RC_MODE_H265AVBR;
+		rc->stH265Avbr.u32Gop = gop;
+		rc->stH265Avbr.u32SrcFrameRateNum = c->fps;
+		rc->stH265Avbr.u32SrcFrameRateDen = 1;
+		rc->stH265Avbr.fr32DstFrameRateNum = c->fps;
+		rc->stH265Avbr.fr32DstFrameRateDen = 1;
+		rc->stH265Avbr.u32BitRate = v->bitrate;
+		rc->stH265Avbr.u32MaxBitRate = v->bitrate * 3 / 2;
+		rc->stH265Avbr.u32MinBitRate = v->bitrate / 4;
+	} else { /* "cbr" and anything else */
+		rc->enRcMode = VENC_RC_MODE_H265CBR;
+		rc->stH265Cbr.u32Gop = gop;
+		rc->stH265Cbr.u32SrcFrameRateNum = c->fps;
+		rc->stH265Cbr.u32SrcFrameRateDen = 1;
+		rc->stH265Cbr.fr32DstFrameRateNum = c->fps;
+		rc->stH265Cbr.fr32DstFrameRateDen = 1;
+		rc->stH265Cbr.u32BitRate = v->bitrate;
+	}
+}
+
+static int rv1106_venc_start(Rv1106Ctx *c)
+{
+	VENC_CHN_ATTR_S a;
+	VENC_RECV_PIC_PARAM_S recv;
+	VENC_CHN_REF_BUF_SHARE_S share;
+	RK_S32 ret;
+
+	memset(&a, 0, sizeof(a));
+	memset(&recv, 0, sizeof(recv));
+	memset(&share, 0, sizeof(share));
+
+	a.stVencAttr.enType = RK_VIDEO_ID_HEVC;
+	a.stVencAttr.enPixelFormat = RK_FMT_YUV420SP;
+	a.stVencAttr.u32Profile = H265E_PROFILE_MAIN;
+	a.stVencAttr.u32MaxPicWidth = c->width;
+	a.stVencAttr.u32MaxPicHeight = c->height;
+	a.stVencAttr.u32PicWidth = c->width;
+	a.stVencAttr.u32PicHeight = c->height;
+	a.stVencAttr.u32VirWidth = c->width;
+	a.stVencAttr.u32VirHeight = c->height;
+	a.stVencAttr.u32StreamBufCnt = 4;
+	a.stVencAttr.u32BufSize = c->width * c->height / 2;
+	a.stGopAttr.enGopMode = VENC_GOPMODE_NORMALP;
+	rv1106_fill_rc(c, &a.stRcAttr);
+
+	ret = RK_MPI_VENC_CreateChn(RV1106_VENC_CHN, &a);
+	if (ret != RK_SUCCESS) {
+		fprintf(stderr, "ERROR: VENC_CreateChn %#x\n", ret);
+		return -1;
+	}
+	c->venc_up = true;
+
+	share.bEnable = RK_TRUE;
+	(void)RK_MPI_VENC_SetChnRefBufShareAttr(RV1106_VENC_CHN, &share);
+
+	recv.s32RecvPicNum = -1;
+	ret = RK_MPI_VENC_StartRecvFrame(RV1106_VENC_CHN, &recv);
+	if (ret != RK_SUCCESS) {
+		fprintf(stderr, "ERROR: VENC_StartRecvFrame %#x\n", ret);
+		return -1;
+	}
+	return 0;
+}
