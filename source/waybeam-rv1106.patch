+/* ── Live-apply callbacks (HTTP API) ─────────────────────────────────── */
+
+static int rv1106_update_rc(Rv1106Ctx *c, uint32_t bitrate, uint32_t gop)
+{
+	VENC_CHN_ATTR_S a;
+	uint32_t *br = NULL, *g = NULL;
+
+	(void)c;
+	if (RK_MPI_VENC_GetChnAttr(RV1106_VENC_CHN, &a) != RK_SUCCESS)
+		return -1;
+	switch (a.stRcAttr.enRcMode) {
+	case VENC_RC_MODE_H265CBR:
+		br = &a.stRcAttr.stH265Cbr.u32BitRate;
+		g = &a.stRcAttr.stH265Cbr.u32Gop;
+		break;
+	case VENC_RC_MODE_H265VBR:
+		br = &a.stRcAttr.stH265Vbr.u32BitRate;
+		g = &a.stRcAttr.stH265Vbr.u32Gop;
+		a.stRcAttr.stH265Vbr.u32MaxBitRate = bitrate ? bitrate * 3 / 2 : 0;
+		break;
+	case VENC_RC_MODE_H265AVBR:
+		br = &a.stRcAttr.stH265Avbr.u32BitRate;
+		g = &a.stRcAttr.stH265Avbr.u32Gop;
+		a.stRcAttr.stH265Avbr.u32MaxBitRate = bitrate ? bitrate * 3 / 2 : 0;
+		break;
+	default:
+		return -1;
+	}
+	if (bitrate)
+		*br = bitrate;
+	if (gop)
+		*g = gop;
+	return RK_MPI_VENC_SetChnAttr(RV1106_VENC_CHN, &a) == RK_SUCCESS ? 0 : -1;
+}
+
+static int rv1106_apply_bitrate(uint32_t kbps)
+{
+	return g_rv && kbps ? rv1106_update_rc(g_rv, kbps, 0) : -1;
+}
+
+static int rv1106_apply_gop(uint32_t frames)
+{
+	return g_rv ? rv1106_update_rc(g_rv, 0, frames ? frames : 1) : -1;
+}
+
+static int rv1106_apply_verbose(bool on)
+{
+	if (!g_rv)
+		return -1;
+	__atomic_store_n(&g_rv->verbose, on ? 1 : 0, __ATOMIC_RELEASE);
+	return 0;
+}
+
+static int rv1106_request_idr(void)
+{
+	return g_rv && RK_MPI_VENC_RequestIDR(RV1106_VENC_CHN, RK_FALSE) ==
+		RK_SUCCESS ? 0 : -1;
+}
+
+static uint32_t rv1106_query_live_fps(void)
+{
+	return g_rv ? __atomic_load_n(&g_rv->live_fps, __ATOMIC_ACQUIRE) : 0;
+}
+
+static int rv1106_apply_max_payload_size(uint16_t size)
+{
+	(void)size; /* read from the shared config on every access unit */
+	return g_rv ? 0 : -1;
+}
+
+static int rv1106_apply_server(const char *uri)
+{
+	if (!g_rv || !uri || !*uri)
+		return -1;
+	if (rv1106_output_configure(g_rv, uri) != 0)
+		return -1;
+	(void)rv1106_request_idr();
+	return 0;
+}
+
+static int rv1106_apply_output_enabled(bool on)
+{
+	if (!g_rv)
+		return -1;
+	if (on && g_rv->sock < 0 &&
+	    rv1106_apply_server(g_rv->cfg.outgoing.server) != 0)
+		return -1;
+	__atomic_store_n(&g_rv->output_enabled, on ? 1 : 0, __ATOMIC_RELEASE);
+	if (on)
+		(void)rv1106_request_idr();
+	return 0;
+}
