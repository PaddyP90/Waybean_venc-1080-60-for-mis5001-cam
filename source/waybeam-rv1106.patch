+static int rv1106_prepare(void *opaque)
+{
+	Rv1106Ctx *c = opaque;
+	const VencConfigVideo *v = &c->cfg.video0;
+
+	c->width = v->width ? v->width : RV1106_SENSOR_W;
+	c->height = v->height ? v->height : RV1106_SENSOR_H;
+	c->fps = v->fps ? v->fps : RV1106_SENSOR_MAX_FPS;
+
+	/* VENC needs 16-aligned geometry on RV1106. */
+	c->width &= ~1u;
+	c->height &= ~1u;
+
+	pthread_mutex_init(&c->out_lock, NULL);
+	c->sock = -1;
+	c->verbose = c->cfg.system.verbose;
+	c->output_enabled = c->cfg.outgoing.enabled ? 1 : 0;
+	return 0;
+}
+
+/* Ask the sensor driver for the mode matching the requested size (the new
+ * mis5001 driver offers 2592x1944 and a 1920x1080 crop).  Best effort: if the
+ * driver only has one mode it keeps it and the ISP/VI path copes as before. */
+static void rv1106_sensor_select_mode(uint32_t w, uint32_t h)
+{
+	DIR *d = opendir("/sys/class/video4linux");
+	struct dirent *e;
+
+	if (!d)
+		return;
+	while ((e = readdir(d)) != NULL) {
+		char path[256], name[96] = "";
+		FILE *f;
+		int fd;
+		struct v4l2_subdev_format fmt;
+
+		if (strncmp(e->d_name, "v4l-subdev", 10) != 0)
+			continue;
+		snprintf(path, sizeof(path), "/sys/class/video4linux/%s/name",
+			e->d_name);
+		f = fopen(path, "r");
+		if (!f)
+			continue;
+		if (!fgets(name, sizeof(name), f))
+			name[0] = 0;
+		fclose(f);
+		if (!strstr(name, "mis5001"))
+			continue;
+
+		snprintf(path, sizeof(path), "/dev/%s", e->d_name);
+		fd = open(path, O_RDWR);
+		if (fd < 0)
+			break;
+		memset(&fmt, 0, sizeof(fmt));
+		fmt.which = V4L2_SUBDEV_FORMAT_ACTIVE;
+		fmt.pad = 0;
+		fmt.format.width = w;
+		fmt.format.height = h;
+		fmt.format.code = MEDIA_BUS_FMT_SGRBG10_1X10;
+		fmt.format.field = V4L2_FIELD_NONE;
+		if (ioctl(fd, VIDIOC_SUBDEV_S_FMT, &fmt) == 0)
+			printf("> Sensor mode: %ux%u (requested %ux%u) on %s\n",
+				fmt.format.width, fmt.format.height, w, h,
+				e->d_name);
+		else
+			fprintf(stderr, "WARN: sensor S_FMT %ux%u failed on %s\n",
+				w, h, e->d_name);
+		close(fd);
+		break;
+	}
+	closedir(d);
+}
