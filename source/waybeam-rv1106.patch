diff -ruN -x out -x venc_webui.c -x .git orig/waybeam_venc-master/src/rv1106_jpeg.c wv2/waybeam_venc-master/src/rv1106_jpeg.c
--- orig/waybeam_venc-master/src/rv1106_jpeg.c	1970-01-01 00:00:00.000000000 +0000
+++ wv2/waybeam_venc-master/src/rv1106_jpeg.c	2026-11-05 04:22:42.986947116 +0000
@@ -0,0 +1,182 @@
+/* rv1106_jpeg.c — RV1106 JPEG snapshot backend (dashboard live view).
+ *
+ * A second, small ISP output (VI pipe 0, chn 1) is read by user-space
+ * (u32Depth=1) and fed to a JPEG VENC channel with SendFrame — no SYS_Bind,
+ * which the RV1106 media stack rejects for a not-yet-started JPEG channel.
+ * Each capture does VI_GetChnFrame -> VENC_SendFrame -> GetStream -> copy ->
+ * ReleaseStream -> VI_ReleaseChnFrame, so the encoder only works while
+ * somebody is asking and the main H.265 path is untouched in between.  The preview size comes from VencJpegConfig
+ * width/height (the runtime derives it from the main stream's aspect). */
+
+#include "venc_jpeg.h"
+
+#include "rk_debug.h"
+#include "rk_defines.h"
+#include "rk_mpi_mb.h"
+#include "rk_mpi_sys.h"
+#include "rk_mpi_venc.h"
+#include "rk_mpi_vi.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RV_VI_PIPE 0
+#define RV_VI_CHN 1
+#define RV_JPEG_VENC_CHN 1
+
+static int g_vi_up, g_venc_up, g_ready;
+static uint32_t g_quality = 70;
+
+int venc_jpeg_backend_init(const VencJpegConfig *cfg)
+{
+	VI_CHN_ATTR_S vi;
+	VENC_CHN_ATTR_S a;
+	VENC_JPEG_PARAM_S jp;
+	VENC_RECV_PIC_PARAM_S recv;
+	uint32_t w, h;
+	RK_S32 ret;
+
+	if (!cfg || !cfg->enabled)
+		return -ENOENT;
+	w = cfg->width ? cfg->width : 640;
+	h = cfg->height ? cfg->height : 480;
+	if (cfg->quality)
+		g_quality = cfg->quality > 99 ? 99 : cfg->quality;
+
+	memset(&vi, 0, sizeof(vi));
+	vi.stIspOpt.u32BufCount = 2;
+	vi.stIspOpt.enMemoryType = VI_V4L2_MEMORY_TYPE_DMABUF;
+	vi.stSize.u32Width = w;
+	vi.stSize.u32Height = h;
+	vi.enPixelFormat = RK_FMT_YUV420SP;
+	vi.enCompressMode = COMPRESS_MODE_NONE;
+	vi.u32Depth = 1; /* user-space reads this channel */
+	ret = RK_MPI_VI_SetChnAttr(RV_VI_PIPE, RV_VI_CHN, &vi);
+	if (ret == RK_SUCCESS)
+		ret = RK_MPI_VI_EnableChn(RV_VI_PIPE, RV_VI_CHN);
+	if (ret != RK_SUCCESS) {
+		fprintf(stderr, "[jpeg-rv1106] VI chn%d %ux%u failed %#x\n",
+			RV_VI_CHN, w, h, ret);
+		return -EIO;
+	}
+	g_vi_up = 1;
+
+	memset(&a, 0, sizeof(a));
+	a.stVencAttr.enType = RK_VIDEO_ID_JPEG;
+	a.stVencAttr.enPixelFormat = RK_FMT_YUV420SP;
+	a.stVencAttr.u32PicWidth = w;
+	a.stVencAttr.u32PicHeight = h;
+	a.stVencAttr.u32VirWidth = w;
+	a.stVencAttr.u32VirHeight = h;
+	a.stVencAttr.u32StreamBufCnt = 2;
+	a.stVencAttr.u32BufSize = w * h;
+	a.stVencAttr.stAttrJpege.bSupportDCF = RK_FALSE;
+	a.stVencAttr.stAttrJpege.stMPFCfg.u8LargeThumbNailNum = 0;
+	a.stVencAttr.stAttrJpege.enReceiveMode = VENC_PIC_RECEIVE_SINGLE;
+	ret = RK_MPI_VENC_CreateChn(RV_JPEG_VENC_CHN, &a);
+	if (ret != RK_SUCCESS) {
+		fprintf(stderr, "[jpeg-rv1106] VENC_CreateChn %#x\n", ret);
+		venc_jpeg_backend_shutdown();
+		return -EIO;
+	}
+	g_venc_up = 1;
+
+	memset(&jp, 0, sizeof(jp));
+	jp.u32Qfactor = g_quality;
+	(void)RK_MPI_VENC_SetJpegParam(RV_JPEG_VENC_CHN, &jp);
+
+	memset(&recv, 0, sizeof(recv));
+	recv.s32RecvPicNum = -1;
+	ret = RK_MPI_VENC_StartRecvFrame(RV_JPEG_VENC_CHN, &recv);
+	if (ret != RK_SUCCESS) {
+		fprintf(stderr, "[jpeg-rv1106] StartRecvFrame %#x\n", ret);
+		venc_jpeg_backend_shutdown();
+		return -EIO;
+	}
+	g_ready = 1;
+	printf("> Snapshot: %ux%u JPEG q%u on VI chn%d\n", w, h, g_quality,
+		RV_VI_CHN);
+	return 0;
+}
+
+int venc_jpeg_backend_capture(uint8_t **out_buf, size_t *out_len,
+	uint32_t timeout_ms)
+{
+	VIDEO_FRAME_INFO_S frame;
+	VENC_STREAM_S stream;
+	VENC_PACK_S pack;
+	RK_S32 ret, wait = timeout_ms ? (RK_S32)timeout_ms : 1000;
+	const uint8_t *data;
+	int rc = -EIO;
+
+	if (!g_ready || !out_buf || !out_len)
+		return -ENOENT;
+
+	memset(&frame, 0, sizeof(frame));
+	ret = RK_MPI_VI_GetChnFrame(RV_VI_PIPE, RV_VI_CHN, &frame, wait);
+	if (ret != RK_SUCCESS)
+		return -ETIMEDOUT;
+
+	ret = RK_MPI_VENC_SendFrame(RV_JPEG_VENC_CHN, &frame, wait);
+	if (ret != RK_SUCCESS) {
+		RK_MPI_VI_ReleaseChnFrame(RV_VI_PIPE, RV_VI_CHN, &frame);
+		return -EIO;
+	}
+
+	memset(&stream, 0, sizeof(stream));
+	memset(&pack, 0, sizeof(pack));
+	stream.pstPack = &pack;
+	ret = RK_MPI_VENC_GetStream(RV_JPEG_VENC_CHN, &stream, wait);
+	if (ret == RK_SUCCESS) {
+		data = RK_MPI_MB_Handle2VirAddr(pack.pMbBlk);
+		if (data && pack.u32Len) {
+			uint8_t *copy = malloc(pack.u32Len);
+
+			if (copy) {
+				memcpy(copy, data, pack.u32Len);
+				*out_buf = copy;
+				*out_len = pack.u32Len;
+				rc = 0;
+			} else {
+				rc = -ENOMEM;
+			}
+		}
+		RK_MPI_VENC_ReleaseStream(RV_JPEG_VENC_CHN, &stream);
+	} else {
+		rc = -ETIMEDOUT;
+	}
+	RK_MPI_VI_ReleaseChnFrame(RV_VI_PIPE, RV_VI_CHN, &frame);
+	return rc;
+}
+
+void venc_jpeg_backend_shutdown(void)
+{
+	g_ready = 0;
+	if (g_venc_up) {
+		RK_MPI_VENC_StopRecvFrame(RV_JPEG_VENC_CHN);
+		RK_MPI_VENC_DestroyChn(RV_JPEG_VENC_CHN);
+	}
+	if (g_vi_up)
+		RK_MPI_VI_DisableChn(RV_VI_PIPE, RV_VI_CHN);
+	g_venc_up = g_vi_up = 0;
+}
+
+int venc_jpeg_backend_set_quality(uint32_t q)
+{
+	VENC_JPEG_PARAM_S jp;
+
+	if (!g_venc_up)
+		return -ENOENT;
+	if (q < 1)
+		q = 1;
+	if (q > 99)
+		q = 99;
+	memset(&jp, 0, sizeof(jp));
+	jp.u32Qfactor = q;
+	if (RK_MPI_VENC_SetJpegParam(RV_JPEG_VENC_CHN, &jp) != RK_SUCCESS)
+		return -EIO;
+	g_quality = q;
+	return 0;
+}
