+/* The only mode the stock mis5001 kernel driver exposes. */
+#define RV1106_SENSOR_W 2592
+#define RV1106_SENSOR_H 1944
+#define RV1106_SENSOR_MAX_FPS 25
+
+#define RV1106_VI_DEV 0
+#define RV1106_VI_PIPE 0
+#define RV1106_VI_CHN 0
+#define RV1106_VENC_CHN 0
+#define RV1106_CAM_ID 0
+#define RV1106_IQ_DIR_DEFAULT "/etc/iqfiles"
+#define RV1106_GET_STREAM_TIMEOUT_MS 1000
