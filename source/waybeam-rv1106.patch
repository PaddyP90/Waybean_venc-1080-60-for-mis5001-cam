+/* ── Live view ──
+   Polls /api/v1/snapshot.jpg back-to-back at the chosen rate.  The preview
+   comes from a small dedicated JPEG channel, not the main H.265 stream, so
+   it costs the video link nothing while the tab is closed. */
+
+let _live = {on:false, n:0, t0:0, timer:null};
+
+function liveStart(){
+  const img = document.getElementById('live-img');
+  const msg = document.getElementById('live-msg');
+  _live.on = true; _live.n = 0; _live.t0 = performance.now();
+  document.getElementById('live-state').textContent = 'running';
+  const tick = () => {
+    if(!_live.on) return;
+    const t = performance.now();
+    img.onload = () => {
+      if(!_live.on) return;
+      img.style.display = 'inline-block'; msg.style.display = 'none';
+      document.getElementById('live-res').textContent = img.naturalWidth+'x'+img.naturalHeight;
+      _live.n++;
+      const dt = (performance.now() - _live.t0) / 1000;
+      if(dt > 1){ document.getElementById('live-rate').textContent = (_live.n/dt).toFixed(1)+' fps'; if(dt > 5){ _live.n = 0; _live.t0 = performance.now(); } }
+      const per = 1000 / Number(document.getElementById('live-fps').value);
+      _live.timer = setTimeout(tick, Math.max(0, per - (performance.now() - t)));
+    };
+    img.onerror = () => {
+      if(!_live.on) return;
+      msg.style.display = 'block';
+      msg.textContent = 'Snapshot unavailable (is snapshot.enabled true? check the daemon log). Retrying\u2026';
+      _live.timer = setTimeout(tick, 2000);
+    };
+    img.src = '/api/v1/snapshot.jpg?t=' + Date.now();
+  };
+  tick();
+}
+
+function liveStop(){
+  _live.on = false;
+  if(_live.timer){ clearTimeout(_live.timer); _live.timer = null; }
+  const st = document.getElementById('live-state');
+  if(st) st.textContent = 'stopped';
+}
+
+function liveRestart(){ if(_live.on){ liveStop(); liveStart(); } }
+
+function liveIdr(){
+  fetch('/request/idr').then(r => toast(r.ok ? 'Keyframe requested' : 'IDR request failed', r.ok))
+    .catch(e => toast('IDR request failed: '+e.message, false));
+}
