+/* (Re)open the transport for `uri_str`.  Used at startup and by the live
+ * outgoing.server callback; the RTP session state is seeded only once so
+ * the receiver sees a continuous sequence across a destination change. */
+static int rv1106_output_configure(Rv1106Ctx *c, const char *uri_str)
+{
+	VencOutputUri uri;
+	struct sockaddr_storage dst;
+	socklen_t dst_len = 0;
+	VencOutputUriType transport;
+	int sock = -1, connected = 0;
+
+	if (venc_config_parse_output_uri(uri_str, &uri) != 0 ||
+	    (uri.type != VENC_OUTPUT_URI_UDP &&
+	     uri.type != VENC_OUTPUT_URI_UNIX)) {
+		fprintf(stderr, "ERROR: unsupported output URI '%s' "
+			"(udp:// or unix:// only)\n", uri_str);
+		return -1;
+	}
+	transport = uri.type;
+	if (output_socket_configure(&sock, &dst, &dst_len, &transport, &uri,
+		c->cfg.outgoing.connected_udp,
+		c->cfg.outgoing.allow_unix_encoder_stall, &connected) != 0) {
+		fprintf(stderr, "ERROR: cannot open output %s\n", uri_str);
+		return -1;
+	}
+	pthread_mutex_lock(&c->out_lock);
+	if (c->sock >= 0)
+		close(c->sock);
+	c->sock = sock;
+	c->dst = dst;
+	c->dst_len = dst_len;
+	c->transport = transport;
+	c->connected_udp = connected;
+	c->uri = uri;
+	pthread_mutex_unlock(&c->out_lock);
+	return 0;
+}
+
+static void rv1106_rtp_seed(Rv1106Ctx *c)
+{
+	RtpSessionState sess;
+
+	rtp_session_init(&sess, rtp_session_payload_type(PT_H265), c->fps);
+	c->rtp.seq = sess.seq;
+	c->rtp.timestamp = sess.timestamp;
+	c->rtp.ssrc = sess.ssrc;
+	c->rtp.payload_type = sess.payload_type;
+	c->frame_ticks = sess.frame_ticks;
+}
