diff -ruN -x out -x venc_webui.c -x .git orig/waybeam_venc-master/init.d/S95waybeam.rv1106 wv2/waybeam_venc-master/init.d/S95waybeam.rv1106
--- orig/waybeam_venc-master/init.d/S95waybeam.rv1106	1970-01-01 00:00:00.000000000 +0000
+++ wv2/waybeam_venc-master/init.d/S95waybeam.rv1106	2026-11-04 10:07:32.010643827 +0000
@@ -0,0 +1,16 @@
+#!/bin/sh
+# Luckfox Pico Ultra (RV1106) launcher.  Assumes the mis5001 driver is built
+# into / loaded by the kernel and /etc/iqfiles holds the sensor's IQ json.
+DAEMON=/usr/bin/waybeam
+export WAYBEAM_IQ_DIR=/etc/iqfiles
+
+case "$1" in
+start)
+	start-stop-daemon -S -b -m -p /var/run/waybeam.pid -x $DAEMON ;;
+stop)
+	start-stop-daemon -K -p /var/run/waybeam.pid ;;
+restart)
+	$0 stop; sleep 1; $0 start ;;
+*)
+	echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
+esac
