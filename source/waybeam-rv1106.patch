+typedef struct {
+	VencConfig cfg;
+	VencOutputUri uri;
+	rk_aiq_sys_ctx_t *aiq;
+	bool sys_up;
+	bool vi_up;
+	bool venc_up;
+	bool bound;
+	uint32_t width;
+	uint32_t height;
+	uint32_t fps;
+	int sock;
+	struct sockaddr_storage dst;
+	socklen_t dst_len;
+	VencOutputUriType transport;
+	int connected_udp;
+	RtpPacketizerState rtp;
+	uint32_t frame_ticks;
+	HevcRtpStats rtp_stats;
+	pthread_mutex_t out_lock;   /* guards sock/dst/transport swaps */
+	int output_enabled;
+	int verbose;
+	uint32_t live_fps;          /* frames delivered in the last second */
+	bool httpd_up;
+	uint64_t last_pts_us;       /* camera timestamp of the previous AU */
+} Rv1106Ctx;
