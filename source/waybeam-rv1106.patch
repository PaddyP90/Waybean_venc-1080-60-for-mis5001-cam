+static const VencApplyCallbacks g_rv1106_callbacks = {
+	.apply_bitrate = rv1106_apply_bitrate,
+	.apply_gop = rv1106_apply_gop,
+	.apply_verbose = rv1106_apply_verbose,
+	.request_idr = rv1106_request_idr,
+	.query_live_fps = rv1106_query_live_fps,
+	.apply_max_payload_size = rv1106_apply_max_payload_size,
+	.apply_server = rv1106_apply_server,
+	.apply_output_enabled = rv1106_apply_output_enabled,
+	.apply_snapshot_quality = venc_jpeg_set_quality,
+};
