#!/bin/sh
# Start waybeam at boot in place of the stock rkipc camera app.
export WAYBEAM_IQ_DIR=/etc/iqfiles
HTS=@HTS@

for d in /oem/usr/lib /usr/lib /lib; do
	[ -f "$d/librockit.so" ] && LD_LIBRARY_PATH="$d:${LD_LIBRARY_PATH:-}" && break
done
export LD_LIBRARY_PATH

running() { ps | grep -v grep | grep -q "$1"; }

case "$1" in
start)
	(
		# At power-up RkLunch.sh loads the camera driver and Ethernet, then starts
		# rkipc: wait for it.  On a manual restart later there is nothing to wait for.
		up=$(cut -d. -f1 /proc/uptime 2>/dev/null)
		n=0
		if [ "${up:-999}" -lt 180 ]; then
			while [ $n -lt 60 ] && ! running rkipc; do sleep 1; n=$((n+1)); done
		fi
		killall rkipc 2>/dev/null
		n=0
		while [ $n -lt 10 ] && running rkipc; do sleep 1; n=$((n+1)); done
		echo $HTS > /sys/module/mis5001/parameters/crop_hts 2>/dev/null
		exec /usr/bin/waybeam > /tmp/waybeam.log 2>&1
	) &
	;;
stop)
	killall waybeam 2>/dev/null
	;;
restart)
	$0 stop; sleep 3; $0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"; exit 1
	;;
esac
